# Copy this file to .env and fill in values for local development.
# Never commit .env to git — it is listed in .gitignore.

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated valid API keys. Leave empty to disable auth (local dev).
# Example: API_KEYS=sk_live_abc123,sk_live_xyz789
# Generate a key: python -c "import secrets; print('sk_live_' + secrets.token_urlsafe(24))"
API_KEYS=

# Set to "true" to enforce auth even when API_KEYS is empty.
REQUIRE_API_KEY=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Max requests per window per API key (or IP when auth is disabled).
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ── Webhooks ──────────────────────────────────────────────────────────────────
# Path to the SQLite database that persists webhook registrations.
# On Fly.io with a mounted volume: WEBHOOKS_DB=/data/webhooks.db
WEBHOOKS_DB=data/webhooks.db

# Maximum number of webhooks that can be registered globally.
MAX_WEBHOOKS=100

# Maximum number of webhooks per TikTok username.
MAX_WEBHOOKS_PER_USER=5
