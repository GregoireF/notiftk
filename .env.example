# Copy this file to .env and fill in values.
# Never commit .env to git — it is listed in .gitignore.
#
# Production (Oracle Cloud): set these via the .env file at /opt/notiftk/.env
# Fly.io: use  fly secrets set KEY=value

# ── Authentication ────────────────────────────────────────────────────────────
# Comma-separated admin API keys. Leave empty to disable auth (local dev only).
# Example: API_KEYS=sk_live_abc123,sk_live_xyz789
# Generate: python -c "import secrets; print('sk_live_' + secrets.token_hex(24))"
API_KEYS=

# Secret for /api/admin/* endpoints. Leave empty = endpoints return 404.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_SECRET=

# Set to "true" to enforce auth even when API_KEYS is empty.
REQUIRE_API_KEY=false

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. "*" = all (fine for a public API).
# Example: CORS_ORIGINS=https://mysite.com,https://app.mysite.com
CORS_ORIGINS=*

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite path for webhooks + self-service keys.
# Oracle Cloud: WEBHOOKS_DB=/data/notiftk/webhooks.db
# Local dev:    WEBHOOKS_DB=data/webhooks.db
WEBHOOKS_DB=data/webhooks.db

# ── Webhook limits ────────────────────────────────────────────────────────────
MAX_WEBHOOKS=100
MAX_WEBHOOKS_PER_USER=5

# ── Self-service key limits ───────────────────────────────────────────────────
MAX_KEYS=1000
MAX_KEYS_PER_IP=3

# ── Logging ───────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
